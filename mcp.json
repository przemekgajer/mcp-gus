{
  "mcpServers": {
    "gus-regon": {
      "command": "npx",
      "args": [
        "-y",
        "gus-regon-mcp-server"
      ],
      "env": {
        "GUS_API_KEY": "api_key",
        "NODE_DEBUG": "mcp*,bir*,net,stream"
      },
      "description": "GUS REGON API server for retrieving Polish company data by NIP (VAT number)"
    }
  }
}
